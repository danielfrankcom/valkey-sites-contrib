@@ -0,0 +1,21 @@
+name: Search federation
+
+# A pull request that changes this site's Pagefind version fails here while another Valkey site
+# serves no index for the new version, instead of failing at deploy time (see docs-site/scripts/pagefind-federation.sh).
+on:
+  pull_request:
+    paths:
+      - 'docs-site/package-lock.json'
+      - 'docs-site/scripts/pagefind-federation-skip.txt'
+
+permissions:
+  contents: read
+
+jobs:
+  ready:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
+      - name: Check the other Valkey sites serve an index for this Pagefind version
+        working-directory: docs-site
+        run: ./scripts/pagefind-federation.sh ready public/pagefind-merge.js "$(jq -r '.packages["node_modules/pagefind"].version' package-lock.json)"
