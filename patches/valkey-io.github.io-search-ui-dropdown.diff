diff --git a/templates/includes/head.html b/templates/includes/head.html
index 4073066..2cf4fea 100644
--- a/templates/includes/head.html
+++ b/templates/includes/head.html
@@ -63,6 +63,27 @@
     <!-- defer: the search box isn't needed for first paint. Both scripts run in order once the page is parsed. -->
     <script src="/pagefind/pagefind-ui.js" defer></script>
     <script type="module" src="/pagefind-merge.js"></script>
+    <script>
+      // Load more results automatically: click Pagefind's "Load more results" button when it scrolls into view in the
+      // dropdown. Pagefind replaces the button after each load, so each new one is observed in turn.
+      // DOMContentLoaded fires after pagefind-merge.js (a module script) has created the search box.
+      window.addEventListener('DOMContentLoaded', function () {
+        var tagBox = document.getElementById('site-search');
+        if (!tagBox || !('IntersectionObserver' in window)) return;
+        var loadMore = new IntersectionObserver(function (entries) {
+          entries.forEach(function (entry) {
+            if (entry.isIntersecting) entry.target.click();
+          });
+        }, { root: tagBox.querySelector('.pagefind-ui__drawer'), rootMargin: '0px 0px 100px 0px' });
+        var watchLoadMore = function () {
+          tagBox.querySelectorAll('.pagefind-ui__button:not([data-autoload])').forEach(function (button) {
+            button.setAttribute('data-autoload', '');
+            loadMore.observe(button);
+          });
+        };
+        new MutationObserver(watchLoadMore).observe(tagBox, { childList: true, subtree: true });
+      });
+    </script>
 
     <!-- Nav JS -->
     <script src="/assets/js/nav.js"></script>
