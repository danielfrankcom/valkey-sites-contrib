+  --sl-search-cancel-space: 80px;
+  --sl-search-result-spacing: calc(20px * var(--pagefind-ui-scale));
+  --sl-search-result-pad-inline-start: calc(60px * var(--pagefind-ui-scale));
+  --sl-search-result-pad-inline-end: calc(20px * var(--pagefind-ui-scale));
+  --sl-search-result-pad-block: calc(15px * var(--pagefind-ui-scale));
+  --sl-search-result-nested-pad-block: calc(10px * var(--pagefind-ui-scale));
