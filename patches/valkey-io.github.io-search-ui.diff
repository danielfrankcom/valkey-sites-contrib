+
+// Site search, laid out like the search on the Starlight sites (GLIDE, Valkey Admin, Spring Data Valkey): a button in
+// the header opens a modal holding Pagefind's search box. The rules below are Starlight's (components/Search.astro),
+// with Starlight's light-theme colours and valkey.io's accent. Starlight sizes in rem of 16px; this site's rem is 10px,
+// so sizes are in px.
+.site-search-button,
+.site-search-dialog {
+  --sl-color-white: hsl(224, 10%, 10%);
+  --sl-color-gray-1: hsl(224, 14%, 16%);
+  --sl-color-gray-2: hsl(224, 10%, 23%);
+  --sl-color-gray-3: hsl(224, 7%, 36%);
+  --sl-color-gray-4: hsl(224, 6%, 56%);
+  --sl-color-gray-5: hsl(224, 6%, 77%);
+  --sl-color-gray-6: hsl(224, 20%, 94%);
+  --sl-color-black: #fff;
+  --sl-color-accent-high: #2d2471;
+  --sl-color-accent: #6983ff;
+  --sl-color-accent-low: #e4e0f7;
+  --sl-color-text-accent: #2d2471;
+  --sl-color-text-invert: var(--sl-color-black);
+  --sl-color-backdrop-overlay: hsla(225, 9%, 36%, 0.66);
+  --sl-shadow-lg: 0px 25px 7px rgba(0, 0, 0, 0.01), 0px 16px 6px hsla(0, 0%, 0%, 0.03), 0px 9px 5px hsla(223, 13%, 10%, 0.08),
+    0px 4px 4px hsla(0, 0%, 0%, 0.12), 0px 4px 2px hsla(0, 0%, 0%, 0.04);
+}
+
+// The button. In the header it's a bordered box with the shortcut, like Starlight's on wide screens; in the mobile menu
+// it fills the menu width.
+.site-search-button {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  height: 40px;
+  border: 1px solid var(--sl-color-gray-5);
+  border-radius: 8px;
+  padding-inline: 12px 8px;
+  background-color: var(--sl-color-black);
+  color: var(--sl-color-gray-2);
+  font-family: inherit;
+  font-size: 14px;
+  font-weight: 400;
+  width: 220px;
+  align-self: center;
+  cursor: pointer;
+
+  &:hover {
+    border-color: var(--sl-color-gray-2);
+    color: var(--sl-color-white);
+  }
+
+  > :last-child {
+    margin-inline-start: auto;
+  }
+
+  > kbd {
+    display: flex;
+    border-radius: 4px;
+    font-size: 12px;
+    gap: 0.25em;
+    padding-inline: 6px;
+    background-color: var(--sl-color-gray-6);
+  }
+
+  kbd {
+    font-family: inherit;
+  }
+
+  @media (max-width: 1024px) {
+    width: 100%;
+    order: -1;
+
+    > kbd {
+      display: none !important;
+    }
+  }
+}
+
+.site-search-dialog {
+  margin: 0;
+  padding: 0;
+  background-color: var(--sl-color-gray-6);
+  border: 1px solid var(--sl-color-gray-5);
+  width: 100%;
+  max-width: 100%;
+  height: 100%;
+  max-height: 100%;
+  box-shadow: var(--sl-shadow-lg);
+  @include sans-serif;
+
+  &[open] {
+    display: flex;
+  }
+
+  &::backdrop {
+    background-color: hsla(225, 9%, 36%, 0.66);
+    -webkit-backdrop-filter: blur(4px);
+    backdrop-filter: blur(4px);
+  }
+
+  .dialog-frame {
+    position: relative;
+    display: flex;
+    overflow: auto;
+    flex-direction: column;
+    flex-grow: 1;
+    gap: 16px;
+    padding: 16px;
+  }
+
+  button[data-close-modal] {
+    position: absolute;
+    z-index: 1;
+    display: flex;
+    align-items: center;
+    align-self: flex-end;
+    height: calc(64px * var(--pagefind-ui-scale, 0.8));
+    padding: 4px;
+    border: 0;
+    background: transparent;
+    cursor: pointer;
+    color: var(--sl-color-text-accent);
+    font-family: inherit;
+    font-size: 16px;
+  }
+
+  @media (min-width: 50rem) {
+    margin: 64px auto auto;
+    border-radius: 8px;
+    width: 90%;
+    max-width: 640px;
+    height: max-content;
+    min-height: 240px;
+    max-height: calc(100% - 128px);
+
+    .dialog-frame {
+      padding: 24px;
+    }
+
+    button[data-close-modal] {
+      display: none;
+    }
+  }
+}
+
+[data-search-modal-open] {
+  overflow: hidden;
+}
+
